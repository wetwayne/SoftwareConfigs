#!/usr/bin/bash

help() {
  echo
  echo "This program will rename music files with the format 'trackNumber - artist - title'."
  echo
  echo "Provide the music files you wish to rename to this program as arguments."
  echo "Also works with directories."
  echo
}

main() {
  local fileDirectory="$1"
  #is empty?
  if [ -z "$fileDirectory" ] ; then
    return
  fi
  #is a directory?
  if [ -d "$fileDirectory" ] ; then
    cd "$fileDirectory"
    echo "Entered directory \"$fileDirectory\""
    main *
    cd ".."
    echo "Exited directory \"$fileDirectory\""
  fi
  #separate old name from directory
  local oldName="$(basename "$fileDirectory")"

  local lengthOfDirectoryString=$((${#1}-${#oldName}))
  local dir="${fileDirectory:0:$lengthOfDirectoryString}"

  #is a flac file?
  if [[ "$oldName" =~ flac$ ]] ; then
    flacFormat "$dir" "$oldName"
  #is a mp3 file?
  elif [[ "$oldName" =~ mp3$ ]] ; then
    mp3Format "$dir" "$oldName"
  fi
  shift
  main "$@"
}

flacFormat() {
  local dir="$1"
  local oldName="$2"
  local format="flac"

  local trackNumber="$(metaflac --show-tag='tracknumber' "$dir""$oldName" | sed 's/^TRACKNUMBER=//I')"

  local artist="$(metaflac --show-tag='artist' "$dir""$oldName" | sed 's/^ARTIST=//I')"

  local title="$(metaflac --show-tag='title' "$dir""$oldName" | sed 's/^TITLE=//I')"

  moveFile "$dir" "$oldName" "$format" "$artist" "$title" "$trackNumber"
}

mp3Format() {
  local dir="$1"
  local oldName="$2"
  local format="mp3"

  # this is really slow, condense to single ffprobe call or use alternative mp3 file metadata tool
  local trackNumber="$(ffprobe -loglevel error -show_entries format_tags=track -of default=noprint_wrappers=1:nokey=1 "$dir""$oldName")"

  local artist="$(ffprobe -loglevel error -show_entries format_tags=artist -of default=noprint_wrappers=1:nokey=1 "$dir""$oldName")"

  local title="$(ffprobe -loglevel error -show_entries format_tags=title -of default=noprint_wrappers=1:nokey=1 "$dir""$oldName")"

  moveFile "$dir" "$oldName" "$format" "$artist" "$title" "$trackNumber"
}

moveFile() {
  local dir="$1"
  local oldName="$2"
  local format="$3"
  local artist="$4"
  local title="$5"
  local trackNumber="$6"
  if [ -z "$trackNumber" ] ; then
    trackNumber="0"
  fi
  #remove leading 0's
  if [[ "$trackNumber" =~ ^0[0-9]+$ ]] ; then
    trackNumber="${trackNumber:1}"
  fi
  #remove / in track number
  trackNumber="$(echo "$trackNumber" | sed 's/\/.*$//')"
  #create file name
  local newName="$(printf "%.2d - %s - %s.%s" "$trackNumber" "$artist" "$title" "$format")"

  #replace characters not allowed in exFAT file names with "_"
  newName="$(echo "$newName" | sed 's/[\/\\:*?"<>|[:cntrl:]]/_/g')"

  #move file
  if [ "$oldName" != "$newName" ] ; then
    mv "$dir""$oldName" "$dir""$newName" &> /dev/null
    echo "Renamed \"$dir$oldName\" to \"$newName\""
  fi
}

#process options
options="$(getopt -n "nameMusic" -o h -l help -- "$@")"

#put formatted options into commandline options
eval set -- "$options"

while true ; do
  case $1 in
    -h|--help) #print help
      help
      exit;;
    --) #end of options
      shift
      break;;
  esac
done
#initial main funcion call
main "$@"

